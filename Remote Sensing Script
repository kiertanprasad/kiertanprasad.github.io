files = dir(fullfile(folder,'*.SST.nc'));

lat_min = 30;
lat_max = 45;
lon_min = -75;
lon_max = -45;

all_sst = [];
all_lat = [];
all_lon = [];

for i = 1:length(files)

    filename = fullfile(folder,files(i).name);

    lat  = double(ncread(filename,'/navigation_data/latitude'));
    lon  = double(ncread(filename,'/navigation_data/longitude'));
    sst  = double(ncread(filename,'/geophysical_data/sst'));
    qual = double(ncread(filename,'/geophysical_data/qual_sst'));

    lat(lat == -999) = NaN;
    lon(lon == -999) = NaN;

   sst(sst < -2 | sst > 45) = NaN;

    lon(lon > 180) = lon(lon > 180) - 360;

    % Region + QC + finite values
    region = lat >= lat_min & lat <= lat_max & ...
             lon >= lon_min & lon <= lon_max;

    good_qc = qual <= 1;

    valid = region & good_qc & isfinite(sst) & isfinite(lat) & isfinite(lon);

    if any(valid(:))
        all_sst = [all_sst; sst(valid)];
        all_lat = [all_lat; lat(valid)];
        all_lon = [all_lon; lon(valid)];
    end
end

fprintf('MODIS pixels kept: %d\n', numel(all_sst));
fprintf('SST range: %.2f to %.2f C\n', min(all_sst), max(all_sst));
